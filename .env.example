# コピーして .env を作る（.env は Git 管理外）
# 公開マーケットデータ（足・WebSocket）の取得だけなら API キーは不要。
# 発行する場合は「読み取り専用（取引権限なし）」で発行すること。
BINANCE_API_KEY=
BINANCE_API_SECRET=
DISCORD_WEBHOOK_URL=
DB_PATH=../data/trade.db
SYMBOL=BTCUSDT
TIMEFRAME=5m
BACKFILL_DAYS=365
# 同一銘柄・同一方向のシグナルを再通知しない時間（分）
NOTIFY_COOLDOWN_MINUTES=60
# true にすると起動後最初の評価結果をテスト通知として送る（Webhook の疎通確認用）
NOTIFY_TEST=false
