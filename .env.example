# コピーして .env を作る（.env は Git 管理外）。core-java と ai-python の両方がこのファイルを読む
# 公開マーケットデータ（足・WebSocket）の取得だけなら API キーは不要。
# 発行する場合は「読み取り専用（取引権限なし）」で発行すること。
BINANCE_API_KEY=
BINANCE_API_SECRET=
DISCORD_WEBHOOK_URL=
DB_PATH=../data/trade.db
SYMBOL=BTCUSDT
TIMEFRAME=5m
BACKFILL_DAYS=365
# 同一銘柄・同一方向のシグナルを再通知しない時間（分）
NOTIFY_COOLDOWN_MINUTES=60
# true にすると起動後最初の評価結果をテスト通知として送る（Webhook の疎通確認用）
NOTIFY_TEST=false
# 同じ箇所の障害を再通知しない時間（分）
ALERT_COOLDOWN_MINUTES=30

# ai-python の URL。空なら AI を使わず、ルール一致だけで通知する
AI_SERVICE_URL=http://localhost:8000
# AI の反発確率がこれ以上なら BUY として通知する
PROBABILITY_THRESHOLD=0.7
